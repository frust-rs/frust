//! {{ title_case_name }} — generated by `frust create --arch clean-signals`
//! (plugin-system spec, task 09).
//!
//! A clean-architecture demo, mirroring `examples/huddle`'s
//! controller/use-case/screen shape at the smallest possible scale:
//!
//! - [`LoadGreeting`] is a [`clean_signals::UseCase`] — the one place
//!   "business logic" (here, a mocked ~400ms round trip) lives.
//! - [`GreetingController`] is the view model: it embeds a
//!   `clean_signals::ControllerCore` by composition (the clean-signals
//!   controller idiom) and drives [`LoadGreeting`] through it, publishing
//!   the result as a `clean_signals::AsyncState` signal.
//! - [`{{ title_case_name | replace(" ", "") }}App`] hosts the controller via
//!   `clean_signals_frust::use_controller` — built once when the component
//!   mounts (inside `Component::init`, where a reactive `Owner` is
//!   ambient), disposed when it unmounts — and renders the current
//!   snapshot through `clean_signals_frust::async_view`.
//!
//! See `plugins/clean-signals-frust/src/lib.rs`'s module docs (the
//! "page-controller pattern") for the full contract these helpers depend
//! on, and `examples/huddle` for a larger worked example.
//!
//! **Dev-machine-only scaffold**: this variant's `Cargo.toml` path-deps
//! into the Frust checkout that generated it, plus a sibling
//! `clean-signals-rs` checkout — see that file's dependency comments. Never
//! edit [`frust::app!`]'s invocation below or `main.rs` (spec §5.5's
//! canonical app shape); add screens/state above it instead.

use std::sync::Arc;
use std::time::Duration;

use clean_signals::{
    AsyncState, ControllerCore, Failure, NoParams, RunOptions, UseCase, async_state_signal,
};
use clean_signals_frust::{async_view, use_controller};
use frust::{AnyView, Button, Column, Component, Get, RwSignal, any, spawn_local, text};

/// The app's closed failure enum (see `docs/CODE_STANDARDS.md`'s
/// "Generic-over-`F` failures" convention) — one implementor is enough for
/// a scaffold this small; a real app grows this into a small enum covering
/// its distinct failure modes, the way `examples/huddle`'s `HuddleFailure`
/// does.
#[derive(Clone, Debug, PartialEq, Eq)]
pub struct AppFailure(String);

impl std::fmt::Display for AppFailure {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.write_str(&self.0)
    }
}

// Both `Failure` methods default to `Display`'s output / non-retryable —
// exactly right for this scaffold's single, infallible use case.
impl Failure for AppFailure {}

/// Mocked load latency, long enough that the loading state (see
/// [`{{ title_case_name | replace(" ", "") }}App::build`]) is actually visible before it
/// resolves — swap for a real network/database call in a real app.
const LOAD_LATENCY_MS: u64 = 400;

/// Loads a greeting after a mocked round trip. Never fails in this
/// scaffold; a real use case maps its errors into [`AppFailure`] at the
/// repository boundary instead of returning `Err` here directly.
struct LoadGreeting;

#[cfg_attr(not(target_arch = "wasm32"), clean_signals::async_trait)]
#[cfg_attr(target_arch = "wasm32", clean_signals::async_trait(?Send))]
impl UseCase for LoadGreeting {
    type Params = NoParams;
    type Output = String;
    type Failure = AppFailure;

    async fn execute(&self, _params: NoParams) -> Result<String, AppFailure> {
        clean_signals::sleep(Duration::from_millis(LOAD_LATENCY_MS)).await;
        Ok("Hello from clean-signals!".to_string())
    }
}

/// View model for the root screen: embeds a [`ControllerCore`] by
/// composition (the clean-signals controller idiom) and drives
/// [`LoadGreeting`] through it into [`Self::greeting`].
pub struct GreetingController {
    core: ControllerCore<AppFailure>,
    /// The greeting's async load state — `Loading` drives a placeholder,
    /// `Data(greeting)` the resolved text, `Error` a failure message (see
    /// [`{{ title_case_name | replace(" ", "") }}App::build`]'s `async_view` call).
    pub greeting: RwSignal<AsyncState<String, AppFailure>>,
}

impl GreetingController {
    pub fn new() -> Self {
        Self {
            core: ControllerCore::new(),
            greeting: async_state_signal(),
        }
    }

    /// Runs [`LoadGreeting`] into [`Self::greeting`]. Called once from
    /// [`{{ title_case_name | replace(" ", "") }}App::init`] below (and again on a "Reload" tap).
    pub async fn load(&self) {
        let _ = self
            .core
            .run_into(&LoadGreeting, NoParams, self.greeting, RunOptions::default())
            .await;
    }
}

impl Default for GreetingController {
    fn default() -> Self {
        Self::new()
    }
}

// The `use_controller`/`clean_signals::ControllerCore::run_into` seam needs
// this: a controller shares its `ControllerCore` by `AsRef` rather than by
// field access, so the helpers stay generic over any controller shape.
impl AsRef<ControllerCore<AppFailure>> for GreetingController {
    fn as_ref(&self) -> &ControllerCore<AppFailure> {
        &self.core
    }
}

/// The generated app's root [`Component`] (spec §5.5): hosts a
/// [`GreetingController`] via `use_controller` (built on mount, disposed on
/// unmount — see the module docs) instead of the default template's inline
/// `AppState`.
#[derive(Default)]
pub struct {{ title_case_name | replace(" ", "") }}App;

impl Component for {{ title_case_name | replace(" ", "") }}App {
    type State = Arc<GreetingController>;

    fn init(&self) -> Arc<GreetingController> {
        // An Owner is ambient here (Frust runs every Component::init under
        // its own reactive owner), so `use_controller`'s disposal-on-unmount
        // `on_cleanup` binds correctly.
        let controller = use_controller::<GreetingController, AppFailure>(GreetingController::new);
        let handle = Arc::clone(&controller);
        spawn_local(async move {
            handle.load().await;
        });
        controller
    }

    fn build(&self, state: &mut Arc<GreetingController>) -> AnyView<Arc<GreetingController>> {
        // Tracked read: `GreetingController::load` writes this signal from
        // the spawned task above (or a later "Reload" tap), waking the
        // frame (see `docs/ARCHITECTURE.md`'s Signal-driven wake).
        let snapshot = state.greeting.get();
        async_view(
            snapshot,
            || any(text("Loading…").size(24.0)),
            |greeting: String| {
                any(Column(vec![
                    any(text(greeting).size(24.0)),
                    any(Button(
                        "Reload",
                        |s: &mut Arc<GreetingController>| {
                            let handle = Arc::clone(s);
                            spawn_local(async move {
                                handle.load().await;
                            });
                        },
                    )),
                ]))
            },
            |failure: AppFailure| any(text(failure.user_message()).size(20.0)),
        )
    }
}

// The generated app's sole entry point (spec §5.5/§10): one line binds
// `{{ title_case_name | replace(" ", "") }}App` to all three platforms — the
// Android JNI exports (`target_os = "android"` only), the iOS C-ABI exports
// (unconditional; self-gated to `target_os = "ios"`), and (on desktop) the
// hidden `__frust_main` that `main.rs` calls. Never edit this line or
// `main.rs` — add screens/state to the `Component` above instead.
frust::app!({{ title_case_name | replace(" ", "") }}App);
