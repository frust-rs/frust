//! {{ title_case_name }} — generated by `forgekit create` (spec §12.3).
//!
//! A ready-to-run interactive counter: −/+ buttons drive a value, a checkbox
//! grows a scrolling list, and a slider reports a 0..1 position — the Phase 4A
//! widget/layout/input stack in one screen. Edit `app_logic` to make it yours.

use forgekit::{
    AnyView, Button, Checkbox, Column, Row, SizedBox, Slider, View, any, scroll_view, text,
};

/// Application state (spec §5 `app_logic` model): the view is a pure function of
/// these fields, and every interaction mutates one of them.
pub struct AppState {
    /// The counter value, driven by the −/+ buttons.
    pub count: i64,
    /// Whether the "Extra rows" checkbox is on — grows the filler list, proving
    /// the list length is a function of state (rebuilt each frame).
    pub extra_rows: bool,
    /// The slider position, `0.0..=1.0`.
    pub slider: f64,
}

impl Default for AppState {
    fn default() -> Self {
        Self {
            count: 0,
            extra_rows: false,
            slider: 0.5,
        }
    }
}

/// Pure view function: renders `AppState` into a scrollable counter screen
/// (spec §5). Re-run on every state mutation, so keep it cheap by construction.
///
/// `+ use<>` opts the return type out of capturing the `&mut AppState`
/// lifetime — required in edition 2024, where `-> impl Trait` otherwise
/// captures all in-scope lifetimes. The view borrows nothing from `state`
/// (views are `'static`), so capturing nothing is correct.
pub fn app_logic(state: &mut AppState) -> impl View<AppState> + use<> {
    let count = state.count;
    let extra = state.extra_rows;
    let slider_value = state.slider;
    let rows = if extra { 60 } else { 30 };

    let mut children: Vec<AnyView<AppState>> = Vec::with_capacity(rows + 4);

    children.push(any(text(format!("Count: {count}")).size(32.0)));
    children.push(any(Row(vec![
        any(Button("-", |s: &mut AppState| s.count -= 1)),
        any(SizedBox(Some(16.0), None)),
        any(Button("+", |s: &mut AppState| s.count += 1)),
    ])));
    children.push(any(Checkbox(
        extra,
        "Extra rows",
        |s: &mut AppState, on| {
            s.extra_rows = on;
        },
    )));
    children.push(any(Slider(slider_value, |s: &mut AppState, v| {
        s.slider = v;
    })));
    for i in 0..rows {
        children.push(any(text(format!("Filler row {}", i + 1)).size(20.0)));
    }

    scroll_view(Column(children))
}

// Android entry point: stamps out the `Java_dev_forgekit_ForgeKitSurfaceView_native*`
// JNI exports bound to this app's `AppState`/`app_logic` (spec §10.1). The
// `#[cfg(target_os = "android")]` gate means the macro expands to nothing on
// desktop, where `main.rs` drives the app instead.
#[cfg(target_os = "android")]
forgekit::android_app!(AppState, app_logic);

// iOS entry point: stamps out the fixed `forgekit_*` C-ABI exports the generated
// Swift app calls (spec §10.2), bound to this app's `AppState`/`app_logic`. The
// invocation is unconditional — the macro gates its own generated exports on
// `target_os = "ios"`, so this expands to nothing on desktop/Android where
// `main.rs`/`android_app!` drive the app instead.
forgekit::ios_app!(AppState, app_logic);
