//! {{ title_case_name }} — generated by `forgekit create` (spec §12.3).

use forgekit::{text, View};

/// Application state (spec §5 `app_logic` model).
#[derive(Default)]
pub struct AppState {
    pub greeting: String,
}

/// Pure view function: renders `AppState` into a [`View`] tree. Re-run on
/// every state mutation, so keep it cheap by construction (spec §5).
///
/// `+ use<>` opts the return type out of capturing the `&mut AppState`
/// lifetime — required in edition 2024, where `-> impl Trait` otherwise
/// captures all in-scope lifetimes. The view borrows nothing from `state`
/// (views are `'static`), so capturing nothing is correct.
pub fn app_logic(state: &mut AppState) -> impl View<AppState> + use<> {
    if state.greeting.is_empty() {
        state.greeting = "Hello, {{ project_name }}!".to_string();
    }
    text(state.greeting.clone()).size(32.0)
}

// Android entry point: stamps out the `Java_dev_forgekit_ForgeKitSurfaceView_native*`
// JNI exports bound to this app's `AppState`/`app_logic` (spec §10.1). The
// `#[cfg(target_os = "android")]` gate means the macro expands to nothing on
// desktop, where `main.rs` drives the app instead.
#[cfg(target_os = "android")]
forgekit::android_app!(AppState, app_logic);

// iOS entry point: stamps out the fixed `forgekit_*` C-ABI exports the generated
// Swift app calls (spec §10.2), bound to this app's `AppState`/`app_logic`. The
// invocation is unconditional — the macro gates its own generated exports on
// `target_os = "ios"`, so this expands to nothing on desktop/Android where
// `main.rs`/`android_app!` drive the app instead.
forgekit::ios_app!(AppState, app_logic);
