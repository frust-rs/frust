//! {{ title_case_name }} — generated by `forgekit create` (spec §12.3).
//!
//! NOTE: this won't compile until the `forgekit` facade crate lands
//! (spec §12.3 task 05 notes / task 08); scaffolding correctness is what
//! `forgekit-cli`'s tests cover in the meantime.

use forgekit::{text, View};

/// Application state (spec §5 `app_logic` model).
#[derive(Default)]
pub struct AppState {
    pub greeting: String,
}

/// Pure view function: renders `AppState` into a [`View`] tree. Re-run on
/// every state mutation, so keep it cheap by construction (spec §5).
pub fn app_logic(state: &mut AppState) -> impl View<AppState> {
    if state.greeting.is_empty() {
        state.greeting = "Hello, {{ title_case_name }}!".to_string();
    }
    text(state.greeting.clone())
}
