//! {{ title_case_name }}'s closed failure enum — generated by `frust create
//! --arch clean-signals` (huddle clean-architecture refactor, task 07).
//!
//! One [`Failure`] implementor for the whole scaffold (team-demo's
//! convention, mirrored by `examples/huddle`'s own `failure.rs`): every use
//! case maps its errors into this generic retry/failure vocabulary at the
//! data-layer boundary (see `features::greeting::data::repositories`'s
//! `map_source_error`, this scaffold's single mapping site). Matched
//! exhaustively by presentation code, never string-matched — no catch-all
//! variant.

use std::fmt;

use clean_signals::Failure;

/// Every failure mode this app's use cases can produce.
#[derive(Clone, Debug, PartialEq, Eq)]
pub enum AppFailure {
    /// A transient transport/server error. Safe to retry.
    Network(String),
    /// Input rejected by domain rules (e.g. an empty/too-short name). Not
    /// retryable — retrying with the same bad input would just fail again.
    Validation(String),
}

impl fmt::Display for AppFailure {
    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
        match self {
            AppFailure::Network(msg) => write!(f, "network error: {msg}"),
            AppFailure::Validation(msg) => write!(f, "validation error: {msg}"),
        }
    }
}

impl Failure for AppFailure {
    fn user_message(&self) -> String {
        match self {
            AppFailure::Network(_) => "Connection problem — please try again.".to_string(),
            AppFailure::Validation(msg) => msg.clone(),
        }
    }

    fn is_retryable(&self) -> bool {
        matches!(self, AppFailure::Network(_))
    }
}
