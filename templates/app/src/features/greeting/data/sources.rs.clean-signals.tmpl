//! [`GreetingSource`] — the in-memory stand-in for a real transport (HTTP,
//! database, …), generated by `frust create --arch clean-signals` (huddle
//! clean-architecture refactor, task 07).
//!
//! [`SourceError`] is this source's internal, transport-ish failure type —
//! it **never leaves this layer**. `repositories::map_source_error` is the
//! feature's single conversion site into the domain-facing
//! [`crate::failure::AppFailure`] (the team-demo `TransportError`
//! convention); nothing above `data/` ever sees a [`SourceError`].

use std::time::Duration;

/// Mocked load latency, long enough that the loading state (see
/// `presentation::pages::greeting_page`) is actually visible before it
/// resolves — swap for a real network/database round trip in a real app.
pub const LOAD_LATENCY_MS: u64 = 400;

/// The transport-ish failure [`GreetingSource::fetch_greeting`] can
/// produce. Never fails in this scaffold (see that method's doc) — a real
/// source populates this from an actual transport error.
#[derive(Debug)]
pub enum SourceError {
    /// The mocked backend was unreachable.
    Unavailable(String),
}

/// In-memory "transport" stand-in — a real app swaps this for an HTTP/DB
/// client behind the same `fetch_greeting` shape.
#[derive(Clone, Copy, Default)]
pub struct GreetingSource;

impl GreetingSource {
    /// A fresh source handle (this scaffold's mocked data is static, so the
    /// handle carries no state of its own).
    pub fn new() -> Self {
        Self
    }

    /// Fetches the greeting after a mocked round trip. Never fails in this
    /// scaffold — a real source maps a genuine transport failure into
    /// [`SourceError`] here instead of unwrapping/panicking.
    pub async fn fetch_greeting(&self) -> Result<String, SourceError> {
        clean_signals::sleep(Duration::from_millis(LOAD_LATENCY_MS)).await;
        Ok("Hello from clean-signals!".to_string())
    }
}
