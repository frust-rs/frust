[package]
name = "{{ project_name }}"
version = "0.1.0"
edition = "2024"
publish = false

# `cdylib` is the shared library Android's `System.loadLibrary` loads (the JNI
# bridge); `staticlib` is the archive the iOS Xcode target links (the C-ABI
# `forgekit_*` bridge, spec §10.2); `rlib` keeps the crate usable as a normal Rust
# library for the desktop `main.rs` preview binary (spec §12.9).
[lib]
crate-type = ["cdylib", "staticlib", "rlib"]

[dependencies]
# NOTE: temporary path dependency pointing at the ForgeKit repo checkout
# that generated this project (spec §12.3: "forgekit_path" mechanism is
# explicitly temporary). Once ForgeKit crates are published, `forgekit
# create` will emit a version dependency here instead.
forgekit = { path = "{{ forgekit_path }}" }

# `--release` mode: fully optimized, stripped, single-panic-path binary for
# store distribution (spec §12.2).
[profile.release]
lto = "thin"
strip = "symbols"
panic = "abort"

# `--profile` mode: release performance with symbols + tracing kept for
# on-device performance measurement (spec §12.2). Artifacts land in
# `target/<triple>/profile/` (custom-profile name, verified legal).
[profile.profile]
inherits = "release"
debug = true
strip = "none"

# `[profile.dev]` per-package overrides for the render/shader-compile stack
# (6e Finding 5 / 6e-fix-1 task 03): vello/wgpu/naga's shader-pipeline
# translation runs at `opt-level = 0` by default, which is slow enough on a
# physical iOS device that the OS SIGKILLs a debug `forgekit run` before the
# synchronous, main-thread launch-time shader compile finishes. This app's
# own code stays at the default dev opt-level (fast incremental rebuilds) —
# only these dependencies are bumped. `docs/spec.md` §12.9 documents
# `opt-level = 1` for deps generally; `opt-level = 2` is used here for the
# shader-compile-heavy crates specifically (see forgekit's own root
# `Cargo.toml` for the full rationale — the same override, kept in sync).
[profile.dev.package.vello]
opt-level = 2

[profile.dev.package.vello_shaders]
opt-level = 2

[profile.dev.package.vello_encoding]
opt-level = 2

[profile.dev.package.wgpu]
opt-level = 2

[profile.dev.package.wgpu-core]
opt-level = 2

[profile.dev.package.wgpu-hal]
opt-level = 2

[profile.dev.package.naga]
opt-level = 2
