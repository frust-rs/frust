[package]
name = "{{ project_name }}"
version = "0.1.0"
edition = "2024"
publish = false

# `cdylib` is the shared library Android's `System.loadLibrary` loads (the JNI
# bridge); `staticlib` is the archive the iOS Xcode target links (the C-ABI
# `forgekit_*` bridge, spec §10.2); `rlib` keeps the crate usable as a normal Rust
# library for the desktop `main.rs` preview binary (spec §12.9).
[lib]
crate-type = ["cdylib", "staticlib", "rlib"]

[dependencies]
# NOTE: temporary path dependency pointing at the ForgeKit repo checkout
# that generated this project (spec §12.3: "forgekit_path" mechanism is
# explicitly temporary). Once ForgeKit crates are published, `forgekit
# create` will emit a version dependency here instead.
forgekit = { path = "{{ forgekit_path }}" }
