[app]
name = "{{ project_name }}"
org = "{{ org }}"
description = "{{ description }}"

{% if deeplink_scheme -%}
# Deep-link scheme registered in the generated Android manifest / iOS
# Info.plist. Informational here — Frust tooling doesn't parse
# this section; it documents what `frust create --deeplink-scheme` baked
# into the platform templates. Editing it does NOT re-render the manifest/
# Info.plist — re-run `frust create --overwrite` (or edit the platform
# files directly) to change it after scaffolding.
[deeplink]
scheme = "{{ deeplink_scheme }}"
{% if deeplink_host -%}
host = "{{ deeplink_host }}"
{% endif %}
{% endif -%}
# [flavors]
# dev = { app-id-suffix = ".dev" }
# prod = {}

# Android release signing. By default the Gradle build reads
# `android/key.properties`, a Java properties file that must stay gitignored
# (the generated .gitignore already excludes `key.properties` and `*.jks`) so
# the keystore and passwords never enter version control. Keys:
#   storePassword=<keystore password>
#   keyPassword=<key password>
#   keyAlias=<key alias>
#   storeFile=<path to .jks, relative to the android/ dir>
# Generate an upload keystore with:
#   keytool -genkey -v -keystore ~/upload-keystore.jks -keyalg RSA \
#     -storetype JKS -keysize 2048 -validity 10000 -alias upload
# Without usable signing material, Gradle falls back to debug signing (a
# warning is logged); `frust build --release` makes it a hard error instead —
# it resolves all four values and checks the keystore file exists, so a stub
# `key.properties` can't buy a green, debug-signed release.
#
# The section below IS parsed by Frust (unlike the deeplink/flavor sections
# above, which only document what was baked into the platform templates).
# Set it when your Gradle build reads signing material from somewhere else:
# [signing]
# # Properties file path, relative to `android/`. Default: "key.properties".
# key-properties = "app/keystores/key.properties"
# # Prefix on the property keys, for a file holding several key sets
# # (`prod.storeFile`, `develop.storeFile`, ...). Default: none.
# prefix = "prod"
# # Waives the gate when signing happens somewhere Frust can't inspect (a CI
# # signing service, a Gradle signing plugin). Every release build then warns
# # that Frust cannot promise the artifact is release-signed.
# external = false
#
# Environment variables each value falls back to when the properties file
# doesn't supply it (a blank entry counts as not supplied) — the CI half of a
# "properties file locally, environment in CI" rig. Only the variable NAMES
# belong here, never the values.
#
# The generated `android/app/build.gradle.kts` reads exactly the four names
# below, hardcoded: Gradle cannot read frust.toml, so there is no pass-through.
# Uncommenting this block as-is is enough for the CI rig to work end to end;
# renaming a variable here means editing `signingValue(...)` in that Gradle
# file to match, or the gate will pass on material the build never sees and
# the artifact will be debug-signed.
# [signing.env]
# store-file = "ANDROID_STORE_FILE"
# store-password = "ANDROID_STORE_PASSWORD"
# key-alias = "ANDROID_KEY_ALIAS"
# key-password = "ANDROID_KEY_PASSWORD"

# Override the derived iOS bundle identifier (defaults to
# `org.camelCase(name)`, e.g. `{{ iosIdentifier }}`).
# [ios]
# identifier = "{{ iosIdentifier }}"
