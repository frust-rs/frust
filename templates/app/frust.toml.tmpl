[app]
name = "{{ project_name }}"
org = "{{ org }}"
description = "{{ description }}"

# Desktop (macOS/Windows/Linux) shell identity. These values were rendered
# into `macos/Info.plist`, `windows/build.rs`'s resource block and
# `linux/app.desktop` at scaffold time; editing them here does NOT rewrite
# those files. `frust build` copies each of them verbatim, so a hand edit
# always wins. What `name`/`identifier` still drive at build time is the
# NAMES the bundle is assembled under (the `.app` directory, the `.desktop`
# file and its icon leaves, the generated `.icns`) plus the fallback
# `Info.plist`/`app.desktop` generated for a project that ships neither.
# Change an identity in both places: a build reports a disagreement rather
# than reconciling it silently — an `Info.plist` `CFBundleExecutable` naming
# a binary that isn't there fails the build, and identifier/`Exec=`/icon-name
# drift comes back as a warning.
#
# `icon` is the single source image the icon pipeline derives every
# platform's app icon from (`.icns`/`.ico`/`hicolor` PNGs) — point it at a
# higher-resolution asset than the bundled demo logo before shipping.
[desktop]
name = "{{ title_case_name }}"
identifier = "{{ desktop_identifier }}"
icon = "assets/logo.png"

# macOS-only overrides. `signing-identity` sets the identity `frust build
# macos` codesigns the assembled `.app` with. `minimum-system-version` feeds
# a GENERATED `Info.plist` only — this project ships its own
# `macos/Info.plist` (copied verbatim), so change
# `LSMinimumSystemVersion` there.
# `notarize` opts an `--installer dmg` build into Apple notarization: the
# packaging step then UPLOADS the signed app to Apple's notary service using
# APPLE_* credentials from your environment (off by default — those variables
# are removed from the packaging step's environment instead).
# [macos]
# minimum-system-version = "{{ macos_minimum_system_version }}"
# signing-identity = "Developer ID Application: Example Org (TEAMID1234)"
# notarize = true

# Windows-only overrides. The FileVersion/ProductVersion a compiled `.exe`
# carries are set by this project's own `windows/build.rs` at app-build time
# (defaults "1.0.0.0"/"1.0.0" — edit them there). `frust build` does not
# apply the values below; it only reports that the `.exe`'s own build script
# owns them.
# [windows]
# file-version = "1.0.0.0"
# product-version = "1.0.0"

# Linux-only overrides. Uncomment to change the freedesktop `Categories=`
# entry `linux/app.desktop` renders (default "Utility").
# [linux]
# categories = ["Utility"]

{% if deeplink_scheme -%}
# Deep-link scheme registered in the generated Android manifest / iOS
# Info.plist. Informational here — Frust tooling doesn't parse
# this section; it documents what `frust create --deeplink-scheme` baked
# into the platform templates. Editing it does NOT re-render the manifest/
# Info.plist — re-run `frust create --overwrite` (or edit the platform
# files directly) to change it after scaffolding.
[deeplink]
scheme = "{{ deeplink_scheme }}"
{% if deeplink_host -%}
host = "{{ deeplink_host }}"
{% endif %}
{% endif -%}
# [flavors]
# dev = { app-id-suffix = ".dev" }
# prod = {}

# Android release signing. By default the signing material lives in
# `android/key.properties`, a Java properties file that must stay gitignored
# (the generated .gitignore already excludes `key.properties` and `*.jks`) so
# the keystore and passwords never enter version control. Keys:
#   storePassword=<keystore password>
#   keyPassword=<key password>
#   keyAlias=<key alias>
#   storeFile=<path to .jks, relative to the android/ dir>
# Generate an upload keystore with:
#   keytool -genkey -v -keystore ~/upload-keystore.jks -keyalg RSA \
#     -storetype JKS -keysize 2048 -validity 10000 -alias upload
#
# Each value also falls back to an environment variable when the properties
# file doesn't supply it (a blank entry counts as not supplied) — the CI half
# of the common "properties file locally, environment in CI" rig. The defaults
# need no configuration at all:
#   ANDROID_STORE_FILE  ANDROID_STORE_PASSWORD
#   ANDROID_KEY_ALIAS   ANDROID_KEY_PASSWORD
#
# `frust build --release` / `frust run --release` resolve all four values,
# check the keystore file really exists, and then write what they resolved to
# `android/.frust-signing.properties` for the Gradle build to read — deleting
# it again the moment Gradle returns. That file is the single source of truth:
# Gradle signs with exactly what the gate verified, so a green build and a
# release-signed artifact are the same fact. A stub `key.properties` can't buy
# a green, debug-signed release. Running `./gradlew assembleRelease` by hand
# (Android Studio) skips Frust entirely — Gradle then falls back to
# `key.properties` + the four `ANDROID_*` variables, and Frust makes no promise
# about that path; it debug-signs with a warning if nothing resolves.
#
# The section below IS parsed by Frust (unlike the deeplink/flavor sections
# above, which only document what was baked into the platform templates).
# Set it when your signing material lives somewhere other than the defaults —
# Frust resolves whatever you describe here and hands Gradle the result, so
# there is nothing to keep in sync on the Gradle side:
# [signing]
# # Properties file path, relative to `android/`. Default: "key.properties".
# key-properties = "app/keystores/key.properties"
# # Prefix on the property keys, for a file holding several key sets
# # (`prod.storeFile`, `develop.storeFile`, ...). Default: none. Frust strips
# # it before handing the values to Gradle.
# prefix = "prod"
# # Waives the gate when signing happens somewhere Frust can't inspect (a CI
# # signing service, a Gradle signing plugin). Nothing is resolved or generated
# # and every release build warns that Frust cannot promise the artifact is
# # release-signed.
# external = false
#
# Renames the environment variable behind any value, overriding the
# `ANDROID_*` defaults above. Only the variable NAMES belong here, never the
# values. No matching Gradle edit is needed — Frust resolves the variable and
# passes the value on.
# [signing.env]
# store-file = "CI_STORE_FILE"
# store-password = "CI_STORE_PASSWORD"
# key-alias = "CI_KEY_ALIAS"
# key-password = "CI_KEY_PASSWORD"

# Override the derived iOS bundle identifier (defaults to
# `org.camelCase(name)`, e.g. `{{ iosIdentifier }}`).
# [ios]
# identifier = "{{ iosIdentifier }}"
