package {{ android_identifier }}

import android.app.Activity
import android.os.Bundle
import dev.forgekit.ForgeKitSurfaceView

/**
 * Generated by `forgekit create` (spec Phase 2 §10.1). Hosts the ForgeKit
 * render surface as the activity's entire content view and forwards the
 * lifecycle callbacks the Choreographer render loop needs.
 */
class MainActivity : Activity() {
    private lateinit var surfaceView: ForgeKitSurfaceView

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        surfaceView = ForgeKitSurfaceView(this)
        setContentView(surfaceView)
    }

    override fun onResume() {
        super.onResume()
        surfaceView.onResume()
    }

    override fun onPause() {
        surfaceView.onPause()
        super.onPause()
    }

    override fun onDestroy() {
        surfaceView.onDestroy()
        super.onDestroy()
    }
}
