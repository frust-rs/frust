// Generated by `forgekit create` (spec Phase 2 task 22). AGP 9's built-in
// Kotlin support means no separate `org.jetbrains.kotlin.android` plugin is
// applied — `com.android.application` alone is enough.
plugins {
    id("com.android.application")
}

android {
    namespace = "{{ android_identifier }}"
    compileSdk = 36

    defaultConfig {
        applicationId = "{{ android_identifier }}"
        minSdk = 24
        targetSdk = 36
        versionCode = 1
        versionName = "1.0"
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }
}

// Builds the Rust `.so` via `cargo ndk` before every Gradle build (spec
// Phase 2 task 22 — arm64-v8a only; more ABIs are future work). `working
// Dir` is the Rust app root (two levels up from `android/app/`); `-o`
// points at this module's `jniLibs` so the resulting
// `arm64-v8a/lib{{ project_name }}.so` lands where Gradle packages native
// libraries from automatically. `forgekit run` runs its own preflight
// checks (Rust target, cargo-ndk, Java, adb) before invoking Gradle; this
// task assumes the toolchain is already on `PATH` and fails loudly
// (inherited from the shell) if it isn't.
val cargoNdkBuild = tasks.register<Exec>("cargoNdkBuild") {
    workingDir = file("../..")
    commandLine(
        "cargo",
        "ndk",
        "-t",
        "arm64-v8a",
        "-o",
        file("src/main/jniLibs").absolutePath,
        "build",
    )
}

tasks.named("preBuild") {
    dependsOn(cargoNdkBuild)
}
