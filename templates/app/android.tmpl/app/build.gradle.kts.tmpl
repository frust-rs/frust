// Generated by `frust create`. AGP 9's built-in Kotlin support means no
// separate `org.jetbrains.kotlin.android` plugin is applied —
// `com.android.application` alone is enough.
//
// This is the full Frust build-mode matrix: debug, profile, and release build
// types, release signing, optional per-ABI splits, version plumbing via
// local.properties, and a `-P`-parameterized cargo-ndk step. Every input the
// Frust CLI passes is a Gradle `-P` project property or a
// `local.properties`/`.frust-signing.properties` entry — there are no
// additional scaffold placeholders here, only build-time values with
// Kotlin-side defaults, so an Android-Studio-driven build (no CLI) still works
// with sensible defaults.
import java.util.Properties
import java.io.FileInputStream
import java.util.Base64
import com.android.build.api.variant.FilterConfiguration.FilterType.ABI

plugins {
    id("com.android.application")
}

// `local.properties` carries CLI-written version plumbing (never committed).
val localProperties = Properties().apply {
    val f = rootProject.file("local.properties")
    if (f.exists()) FileInputStream(f).use { load(it) }
}

// ---------------------------------------------------------------------------
// Release signing: ONE source of truth, plus a no-promises fallback.
// ---------------------------------------------------------------------------
//
// `.frust-signing.properties` is written by `frust build`/`frust run` (release
// only) immediately before this build starts, and deleted the moment it
// returns — success or failure. It holds exactly the four values the CLI's
// release-signing gate resolved out of frust.toml's `[signing]` section, with
// the key prefix already applied-and-stripped, `[signing.env]`/`ANDROID_*`
// fallbacks already folded in, and `storeFile` already made absolute. Reading
// it FIRST is what makes the gate's verdict and this build's signature the
// same fact: there is no path/prefix/env-name axis left for the two sides to
// disagree on. Do not commit it (the app's .gitignore excludes it) and do not
// hand-edit it — it holds the keystore passwords in plaintext and is
// regenerated per build.
val frustSigningProperties = Properties().apply {
    val f = rootProject.file(".frust-signing.properties")
    if (f.exists()) FileInputStream(f).use { load(it) }
}

// `key.properties` (a Java properties file that must stay gitignored) plus the
// four `ANDROID_*` environment variables are the FALLBACK, for a `./gradlew`
// run directly — Android Studio, or a CI job driving Gradle itself. Frust is
// not involved there, so `.frust-signing.properties` does not exist and
// **Frust makes no promise about the result**: the release-signing gate covers
// `frust build`/`frust run` only. Nothing verifies that this fallback finds
// the same material the gate would, and a hand-run build that resolves nothing
// here debug-signs with the warning below. Edit these lookups freely to match
// your own signing rig; the `frustSigning(...)` read above sits ahead of them
// and is unaffected.
val keystoreProperties = Properties().apply {
    val f = rootProject.file("key.properties")
    if (f.exists()) FileInputStream(f).use { load(it) }
}

// The Frust-written value for `property`, or null when no CLI build wrote one.
// Keys here are always the plain, unprefixed Gradle names.
fun frustSigning(property: String): String? =
    frustSigningProperties.getProperty(property)?.trim()?.takeIf { it.isNotEmpty() }

// The fallback: `key.properties` entry first, then the environment variable,
// with a blank value counting as absent at BOTH steps — an empty
// `storePassword=` line is not signing material and falls through to the
// environment.
fun signingValue(property: String, envVar: String): String? =
    keystoreProperties.getProperty(property)?.trim()?.takeIf { it.isNotEmpty() }
        ?: System.getenv(envVar)?.trim()?.takeIf { it.isNotEmpty() }

// Reads a Gradle `-P` project property with a Kotlin-side default, so every
// CLI-driven knob has a working default for Android-Studio-driven builds.
fun prop(name: String, default: String): String =
    (project.findProperty(name) as String?) ?: default

// Version plumbing (Flutter-canonical mechanism, Frust keys). The CLI
// writes `frust.versionName`/`frust.versionCode` into local.properties;
// defaults keep a hand-run Gradle build working.
val versionNameValue = localProperties.getProperty("frust.versionName", "1.0")
val versionCodeValue = localProperties.getProperty("frust.versionCode", "1").toInt()

// ABI selection + split toggle. `frust.targetPlatforms` is a CSV of Android
// ABIs (default single-ABI arm64-v8a, matching `frust run`'s per-device
// build); `frust.splitPerAbi` gates per-ABI APK splits (off by default — a
// universal APK/AAB is produced instead).
val abis = prop("frust.targetPlatforms", "arm64-v8a")
    .split(",").map { it.trim() }.filter { it.isNotEmpty() }
val splitPerAbi = prop("frust.splitPerAbi", "false").toBoolean()

// `--define K=V` values, base64(`K=V;K=V`) so an arbitrary value survives the
// shell/`-P` boundary. Decoded and set as env vars on the cargo-ndk exec below
// so the Rust side's `option_env!("K")` can read them at compile time.
val definesB64 = prop("frust.defines", "")

// Cargo `--features` selected by the CLI per build mode (release-lean plan):
// base64(`feat,feat`), decoded and appended to the cargo-ndk build below as
// `--features <csv>`. The CLI passes `frust/perf-trace` for debug/profile
// (instrumentation compiled IN) and `lean` for release (the log ceiling);
// empty default so an Android-Studio-driven build (no CLI) adds no features.
// Rides a `-P` property — NOT an env var — so a feature flag can never fall
// foul of the release env-drop Known Issue by construction.
val cargoFeaturesB64 = prop("frust.cargoFeatures", "")

android {
    namespace = "{{ android_identifier }}"
    compileSdk = 36

    defaultConfig {
        applicationId = "{{ android_identifier }}"
        minSdk = 26
        targetSdk = 36
        versionCode = versionCodeValue
        versionName = versionNameValue
    }

    signingConfigs {
        // Wire a release signing config only when all four values resolve.
        // Frust's generated file wins outright; otherwise the no-promises
        // fallback (key.properties, then the environment) applies. When
        // neither resolves all four, release falls back to debug signing with
        // a warning so an unsigned local build still succeeds. `frust build`
        // (CLI) makes that same situation a hard error before Gradle even
        // starts — the fallback exists for Android-Studio-driven builds.
        val resolvedStoreFile =
            frustSigning("storeFile") ?: signingValue("storeFile", "ANDROID_STORE_FILE")
        val resolvedStorePassword =
            frustSigning("storePassword") ?: signingValue("storePassword", "ANDROID_STORE_PASSWORD")
        val resolvedKeyAlias =
            frustSigning("keyAlias") ?: signingValue("keyAlias", "ANDROID_KEY_ALIAS")
        val resolvedKeyPassword =
            frustSigning("keyPassword") ?: signingValue("keyPassword", "ANDROID_KEY_PASSWORD")
        if (resolvedStoreFile != null && resolvedStorePassword != null &&
            resolvedKeyAlias != null && resolvedKeyPassword != null
        ) {
            create("release") {
                keyAlias = resolvedKeyAlias
                keyPassword = resolvedKeyPassword
                storeFile = rootProject.file(resolvedStoreFile)
                storePassword = resolvedStorePassword
            }
        }
    }

    buildTypes {
        getByName("release") {
            val releaseSigning = signingConfigs.findByName("release")
            if (releaseSigning != null) {
                signingConfig = releaseSigning
            } else {
                signingConfig = signingConfigs.getByName("debug")
                // THE CLI GREPS THIS WARNING. `frust build`/`frust run
                // --release` scan every release build's Gradle output for the
                // FRUST-SIGNING-FALLBACK token below and hard-fail rather than
                // report success over a debug-signed artifact — the backstop
                // for the case where this file (an older generated project, or
                // an edited signing block) never read
                // `.frust-signing.properties` at all. Reword the prose freely;
                // do NOT drop the token, and if you move it, move
                // `frust-drive`'s `android_build::signing` matcher with it.
                // That matcher also accepts the bare phrase "release build is
                // debug-signed", which every template Frust has ever shipped
                // carries, so projects generated before the token existed keep
                // the same protection.
                logger.warn(
                    "Frust: release build is debug-signed. " +
                        "[FRUST-SIGNING-FALLBACK] Build with " +
                        "`frust build apk --release` (its signing gate refuses " +
                        "to ship this), or — for a hand-run ./gradlew — supply " +
                        "all four signing values in android/key.properties or " +
                        "via ANDROID_STORE_FILE/ANDROID_STORE_PASSWORD/" +
                        "ANDROID_KEY_ALIAS/ANDROID_KEY_PASSWORD. See " +
                        "frust.toml [signing].",
                )
            }
            // R8 + resource shrink: the Kotlin/Java side is
            // small (this app's `MainActivity` plus the `:frust-embedding`
            // module) so the dex win is modest, but shipping unminified
            // release code is not the
            // Frust default. `proguard-rules.pro` carries the two keep
            // rules R8 needs beyond AGP's own default rule set (JNI-bound
            // classes it can't otherwise prove are live) — see that file's
            // comments.
            isMinifyEnabled = true
            isShrinkResources = true
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules.pro",
            )
        }
        // Profile: release codegen with a debug-signed, non-debuggable package
        // for on-device performance measurement. Its cargo profile
        // (`--profile profile`) keeps symbols/tracing on — see cargoNdkBuild.
        // `initWith(release)` copies every build-type property, including
        // `isMinifyEnabled`/`isShrinkResources`/`proguardFiles` above, so
        // profile stays representative of release's minified/shrunk shape —
        // no separate opt-in needed here.
        create("profile") {
            initWith(getByName("release"))
            signingConfig = signingConfigs.getByName("debug")
            matchingFallbacks += listOf("release", "debug")
            isDebuggable = false
        }
        // `debug` is implicit (AGP-provided) and unchanged: no minification,
        // so no keep-rule risk while iterating.
    }

    // Per-ABI APK splits, off by default. When enabled, one APK per ABI is
    // produced instead of a universal APK.
    splits {
        abi {
            isEnable = splitPerAbi
            reset()
            include(*abis.toTypedArray())
            isUniversalApk = false
        }
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }

    // Native libraries are packaged from this app's `build/android/jniLibs`,
    // where `cargoNdkBuild` below stages them (`-o`) — nothing is written
    // under `src/main/jniLibs` any more, so the source tree stays free of
    // build output and `frust clean` can remove the `.so`s with everything
    // else. Paths in this file resolve against the module directory
    // (`android/app/`), so `../../` is the app root.
    //
    // `srcDir` ADDS a directory; AGP's own `src/main/jniLibs` default stays in
    // the set, so a project migrated from the old layout still packages any
    // stale `.so`s sitting there until `frust clean` removes them. The ABI
    // split/versionCode block below is unaffected either way — it reads the
    // variant's ABI filters, not the library files.
    sourceSets.getByName("main").jniLibs.srcDir("../../build/android/jniLibs")

    // Example flavor scaffold — uncomment and mirror frust.toml's [flavors].
    // flavorDimensions += "env"
    // productFlavors {
    //     create("dev")  { dimension = "env"; applicationIdSuffix = ".dev" }
    //     create("prod") { dimension = "env" }
    // }
}

// Frust's Android embedding: the Kotlin host (`FrustActivity`,
// `FrustSurfaceView`, `FrustViewHost`, the vendored accesskit delegate) this
// app's `MainActivity` extends, plus the JNI declarations the Rust side
// exports against. Included by path — see `settings.gradle.kts` and
// `gradle.properties`' `frust.embedding.dir`.
//
// `androidx.core` (edge-to-edge, inset merging, bar-icon contrast) and
// `androidx.activity` (`ComponentActivity`, `onBackPressedDispatcher`) are
// re-exported transitively by the module's `api` declarations, so this app
// declares neither directly.
dependencies {
    implementation(project(":frust-embedding"))
    // frust:plugin-dependencies — plugin-contributed dependencies go below.
}

// Per-ABI versionCode offsets, applied only when splits are enabled so each
// split APK gets a distinct, monotonic versionCode. Mapping and formula are the
// official Android docs' "Configure multiple APKs" example
// (developer.android.com/build/configure-apk-splits#configure-APK-versions):
// armeabi-v7a→1, arm64-v8a→2, x86→3, x86_64→4, code = abiCode * 1000 + base.
// (The Flutter-lore mapping is a different set — this is the documented one.)
androidComponents {
    onVariants { variant ->
        if (splitPerAbi) {
            val abiCodes = mapOf(
                "armeabi-v7a" to 1,
                "arm64-v8a" to 2,
                "x86" to 3,
                "x86_64" to 4,
            )
            variant.outputs.forEach { output ->
                val abiName = output.filters.find { it.filterType == ABI }?.identifier
                if (abiName != null) {
                    val abiCode = abiCodes[abiName] ?: 0
                    output.versionCode.set(abiCode * 1000 + versionCodeValue)
                }
            }
        }
    }
}

// Builds the Rust `.so`(s) via `cargo ndk` before every Gradle build.
// `workingDir` is the Rust app root (two levels up from `android/app/`); `-o`
// points at that same app root's `build/android/jniLibs`, the app-owned build
// directory registered as a `jniLibs` source directory in the `android` block
// above — so the resulting `<abi>/lib{{ project_name }}.so` is packaged by
// Gradle without any of it landing in `src/main/`. Keep the two paths in step:
// staging somewhere Gradle does not read produces an APK that installs and
// then crashes on `System.loadLibrary`, not a build failure.
//
// The cargo profile is chosen from the invoked task names (debug → `build`,
// profile → `build --profile profile`, release → `build --release`) so the
// single `cargoNdkBuild` task hooked into `preBuild` produces the right
// artifact for whichever variant is being assembled. Targets come from
// `frust.targetPlatforms` (repeated `-t <abi>`), defaulting to arm64-v8a —
// the same single-ABI debug build `frust run` has always produced.
//
// `frust run`/`frust build` run their own preflight (Rust target,
// cargo-ndk, JDK, adb); this task assumes the toolchain is on `PATH` and fails
// loudly (inherited from the shell) if it isn't.
val cargoProfileArgs: List<String> = run {
    val requested = gradle.startParameter.taskNames.joinToString(" ").lowercase()
    when {
        requested.contains("release") -> listOf("build", "--release")
        requested.contains("profile") -> listOf("build", "--profile", "profile")
        else -> listOf("build")
    }
}
val cargoTargetArgs: List<String> = abis.flatMap { listOf("-t", it) }

// Decode the base64 `--features` CSV (empty → no extra features).
val cargoFeatureArgs: List<String> =
    if (cargoFeaturesB64.isEmpty()) {
        emptyList()
    } else {
        listOf("--features", String(Base64.getDecoder().decode(cargoFeaturesB64)))
    }

val cargoNdkBuild = tasks.register<Exec>("cargoNdkBuild") {
    workingDir = file("../..")
    commandLine(
        buildList {
            add("cargo")
            add("ndk")
            addAll(cargoTargetArgs)
            add("-o")
            add(file("../../build/android/jniLibs").absolutePath)
            addAll(cargoProfileArgs)
            addAll(cargoFeatureArgs)
        },
    )
    // Thread `--define`s through as env vars so `option_env!("K")` sees them.
    if (definesB64.isNotEmpty()) {
        String(Base64.getDecoder().decode(definesB64))
            .split(";")
            .filter { it.isNotEmpty() }
            .forEach { kv ->
                val idx = kv.indexOf('=')
                if (idx > 0) environment(kv.substring(0, idx), kv.substring(idx + 1))
            }
    }
}

tasks.named("preBuild") {
    dependsOn(cargoNdkBuild)
}
