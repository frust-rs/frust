// Generated by `forgekit create`. AGP 9's built-in Kotlin support means no
// separate `org.jetbrains.kotlin.android` plugin is applied —
// `com.android.application` alone is enough.
//
// This is the full ForgeKit build-mode matrix (spec §12.2/§12.5): debug,
// profile, and release build types, key.properties release signing, optional
// per-ABI splits, version plumbing via local.properties, and a
// `-P`-parameterized cargo-ndk step. Every input the ForgeKit CLI passes is a
// Gradle `-P` project property or a `local.properties`/`key.properties` entry
// — there are no additional scaffold placeholders here, only build-time
// values with Kotlin-side defaults, so an Android-Studio-driven build (no CLI)
// still works with sensible defaults.
import java.util.Properties
import java.io.FileInputStream
import java.util.Base64
import com.android.build.api.variant.FilterConfiguration.FilterType.ABI

plugins {
    id("com.android.application")
}

// `local.properties` carries CLI-written version plumbing (never committed);
// `key.properties` carries release-signing material (never committed — see
// forgekit.toml's [signing] section and the app's .gitignore). Both are
// optional: absent files yield empty `Properties` and the defaults below apply.
val localProperties = Properties().apply {
    val f = rootProject.file("local.properties")
    if (f.exists()) FileInputStream(f).use { load(it) }
}
val keystoreProperties = Properties().apply {
    val f = rootProject.file("key.properties")
    if (f.exists()) FileInputStream(f).use { load(it) }
}

// Reads a Gradle `-P` project property with a Kotlin-side default, so every
// CLI-driven knob has a working default for Android-Studio-driven builds.
fun prop(name: String, default: String): String =
    (project.findProperty(name) as String?) ?: default

// Version plumbing (Flutter-canonical mechanism, ForgeKit keys). The CLI
// writes `forgekit.versionName`/`forgekit.versionCode` into local.properties;
// defaults keep a hand-run Gradle build working.
val versionNameValue = localProperties.getProperty("forgekit.versionName", "1.0")
val versionCodeValue = localProperties.getProperty("forgekit.versionCode", "1").toInt()

// ABI selection + split toggle. `forgekit.targetPlatforms` is a CSV of Android
// ABIs (default single-ABI arm64-v8a, matching `forgekit run`'s per-device
// build); `forgekit.splitPerAbi` gates per-ABI APK splits (off by default — a
// universal APK/AAB is produced instead).
val abis = prop("forgekit.targetPlatforms", "arm64-v8a")
    .split(",").map { it.trim() }.filter { it.isNotEmpty() }
val splitPerAbi = prop("forgekit.splitPerAbi", "false").toBoolean()

// `--define K=V` values, base64(`K=V;K=V`) so an arbitrary value survives the
// shell/`-P` boundary. Decoded and set as env vars on the cargo-ndk exec below
// so the Rust side's `option_env!("K")` can read them at compile time.
val definesB64 = prop("forgekit.defines", "")

android {
    namespace = "{{ android_identifier }}"
    compileSdk = 36

    defaultConfig {
        applicationId = "{{ android_identifier }}"
        minSdk = 24
        targetSdk = 36
        versionCode = versionCodeValue
        versionName = versionNameValue
    }

    signingConfigs {
        // Only wire a release signing config when key.properties is present;
        // otherwise release falls back to debug signing (with a warning) so an
        // unsigned local build still succeeds. `forgekit build` (CLI) makes a
        // missing keystore a hard error — this fallback is the escape hatch for
        // Android-Studio-driven builds (spec §12.5).
        if (keystoreProperties.isNotEmpty()) {
            create("release") {
                keyAlias = keystoreProperties["keyAlias"] as String
                keyPassword = keystoreProperties["keyPassword"] as String
                storeFile = (keystoreProperties["storeFile"] as String?)?.let { rootProject.file(it) }
                storePassword = keystoreProperties["storePassword"] as String
            }
        }
    }

    buildTypes {
        getByName("release") {
            val releaseSigning = signingConfigs.findByName("release")
            if (releaseSigning != null) {
                signingConfig = releaseSigning
            } else {
                signingConfig = signingConfigs.getByName("debug")
                logger.warn(
                    "ForgeKit: release build is debug-signed; create " +
                        "android/key.properties — see forgekit.toml [signing]",
                )
            }
            // R8 + resource shrink (Phase 7 task 12): the Kotlin/Java side is
            // small (one view, one vendored accesskit delegate) so the dex win
            // is modest, but shipping unminified release code is not the
            // ForgeKit default. `proguard-rules.pro` carries the two keep
            // rules R8 needs beyond AGP's own default rule set (JNI-bound
            // classes it can't otherwise prove are live) — see that file's
            // comments.
            isMinifyEnabled = true
            isShrinkResources = true
            proguardFiles(
                getDefaultProguardFile("proguard-android-optimize.txt"),
                "proguard-rules.pro",
            )
        }
        // Profile: release codegen with a debug-signed, non-debuggable package
        // for on-device performance measurement (spec §12.2). Its cargo profile
        // (`--profile profile`) keeps symbols/tracing on — see cargoNdkBuild.
        // `initWith(release)` copies every build-type property, including
        // `isMinifyEnabled`/`isShrinkResources`/`proguardFiles` above, so
        // profile stays representative of release's minified/shrunk shape —
        // no separate opt-in needed here.
        create("profile") {
            initWith(getByName("release"))
            signingConfig = signingConfigs.getByName("debug")
            matchingFallbacks += listOf("release", "debug")
            isDebuggable = false
        }
        // `debug` is implicit (AGP-provided) and unchanged: no minification,
        // so no keep-rule risk while iterating.
    }

    // Per-ABI APK splits, off by default. When enabled, one APK per ABI is
    // produced instead of a universal APK.
    splits {
        abi {
            isEnable = splitPerAbi
            reset()
            include(*abis.toTypedArray())
            isUniversalApk = false
        }
    }

    compileOptions {
        sourceCompatibility = JavaVersion.VERSION_17
        targetCompatibility = JavaVersion.VERSION_17
    }

    // Example flavor scaffold — uncomment and mirror forgekit.toml's [flavors].
    // flavorDimensions += "env"
    // productFlavors {
    //     create("dev")  { dimension = "env"; applicationIdSuffix = ".dev" }
    //     create("prod") { dimension = "env" }
    // }
}

// Per-ABI versionCode offsets, applied only when splits are enabled so each
// split APK gets a distinct, monotonic versionCode. Mapping and formula are the
// official Android docs' "Configure multiple APKs" example
// (developer.android.com/build/configure-apk-splits#configure-APK-versions):
// armeabi-v7a→1, arm64-v8a→2, x86→3, x86_64→4, code = abiCode * 1000 + base.
// (The Flutter-lore mapping is a different set — this is the documented one.)
androidComponents {
    onVariants { variant ->
        if (splitPerAbi) {
            val abiCodes = mapOf(
                "armeabi-v7a" to 1,
                "arm64-v8a" to 2,
                "x86" to 3,
                "x86_64" to 4,
            )
            variant.outputs.forEach { output ->
                val abiName = output.filters.find { it.filterType == ABI }?.identifier
                if (abiName != null) {
                    val abiCode = abiCodes[abiName] ?: 0
                    output.versionCode.set(abiCode * 1000 + versionCodeValue)
                }
            }
        }
    }
}

// Builds the Rust `.so`(s) via `cargo ndk` before every Gradle build.
// `workingDir` is the Rust app root (two levels up from `android/app/`); `-o`
// points at this module's `jniLibs` so the resulting
// `<abi>/lib{{ project_name }}.so` lands where Gradle packages native
// libraries from automatically.
//
// The cargo profile is chosen from the invoked task names (debug → `build`,
// profile → `build --profile profile`, release → `build --release`) so the
// single `cargoNdkBuild` task hooked into `preBuild` produces the right
// artifact for whichever variant is being assembled. Targets come from
// `forgekit.targetPlatforms` (repeated `-t <abi>`), defaulting to arm64-v8a —
// the same single-ABI debug build `forgekit run` has always produced.
//
// `forgekit run`/`forgekit build` run their own preflight (Rust target,
// cargo-ndk, JDK, adb); this task assumes the toolchain is on `PATH` and fails
// loudly (inherited from the shell) if it isn't.
val cargoProfileArgs: List<String> = run {
    val requested = gradle.startParameter.taskNames.joinToString(" ").lowercase()
    when {
        requested.contains("release") -> listOf("build", "--release")
        requested.contains("profile") -> listOf("build", "--profile", "profile")
        else -> listOf("build")
    }
}
val cargoTargetArgs: List<String> = abis.flatMap { listOf("-t", it) }

val cargoNdkBuild = tasks.register<Exec>("cargoNdkBuild") {
    workingDir = file("../..")
    commandLine(
        buildList {
            add("cargo")
            add("ndk")
            addAll(cargoTargetArgs)
            add("-o")
            add(file("src/main/jniLibs").absolutePath)
            addAll(cargoProfileArgs)
        },
    )
    // Thread `--define`s through as env vars so `option_env!("K")` sees them.
    if (definesB64.isNotEmpty()) {
        String(Base64.getDecoder().decode(definesB64))
            .split(";")
            .filter { it.isNotEmpty() }
            .forEach { kv ->
                val idx = kv.indexOf('=')
                if (idx > 0) environment(kv.substring(0, idx), kv.substring(idx + 1))
            }
    }
}

tasks.named("preBuild") {
    dependsOn(cargoNdkBuild)
}
