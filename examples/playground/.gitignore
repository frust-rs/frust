# All generated/compiled build output for a Frust app lands under this one
# project-relative root (kept in sync with frust_drive::build_dirs::{CLEAN_DIRS,
# LEGACY_CLEAN_DIRS}) — Rust artifacts (`build/rust`, the `[build]
# target-dir` set in this project's `.cargo/config.toml`), Android's Gradle
# output (`build/android`), iOS's `xcodebuild` output (`build/ios`), the
# default web build (`build/web`), and desktop bundles (`build/desktop`).
/build
# pre-build/-layout output and out-of-app cargo invocations; never commit
/target

# Android release signing material — never commit (see frust.toml [signing]).
android/key.properties
*.jks
*.keystore

# Written by `frust build`/`frust run --release` with the signing values the
# CLI gate resolved (plaintext passwords, owner-only) and deleted again the
# moment Gradle returns. One should only ever exist mid-build — if you see it
# in `git status`, a build was killed hard; delete it.
android/.frust-signing.properties

# legacy layout — harmless to keep: build-output paths from before the
# `build/` root migration (kept in sync with `build_dirs::LEGACY_CLEAN_DIRS`,
# which `frust clean` still removes for a pre-migration app whose generated
# Gradle/Xcode config still writes to these paths). `android/build/` is the
# `:frust-embedding` module's redirected output — see
# android/settings.gradle.kts' `gradle.lifecycle.beforeProject` block.
android/app/build/
android/build/
android/.gradle/
dist/
windows/icon.ico
android/app/src/main/jniLibs/

# Machine-local Android SDK path + CLI-written version stamps.
android/local.properties

# Kotlin daemon's per-project cache, created by any `./gradlew compile*Kotlin`
# (the Kotlin gate any camera/native-widgets change has to run). Build output.
.kotlin/
