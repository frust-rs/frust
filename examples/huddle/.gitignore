/target

# Android release signing material — never commit (see frust.toml [signing]).
android/key.properties
*.jks
*.keystore

# CLI-generated build output (kept in sync with `frust clean`'s REMOVED_DIRS).
# android/build/ is the redirected `:frust-embedding` module's build output
# (settings.gradle.kts's `gradle.lifecycle.beforeProject` block) — keeps the
# shared frust checkout's own build dir untouched.
android/app/build/
android/build/
android/.gradle/
build/

# cargo-ndk build output (task 01: `frust build apk` writes the compiled
# .so per-ABI here via the Gradle `cargoNdkBuild` task; regenerated by every
# build, not scaffold source — the upstream `templates/app/.gitignore` should
# gain this line too, flagged for doc/template follow-up).
android/app/src/main/jniLibs/

# Machine-local Android SDK path + CLI-written version stamps.
android/local.properties
