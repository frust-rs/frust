# All generated/compiled build output for a Frust app lands under this one
# project-relative root (kept in sync with `crates/frust-drive`'s
# `build_dirs::BuildLayout`, and with `frust clean`'s
# `build_dirs::{CLEAN_DIRS, LEGACY_CLEAN_DIRS}`) — Rust artifacts
# (`build/rust`, the `[build] target-dir` set in this project's
# `.cargo/config.toml`), Android's Gradle output (`build/android`), iOS's
# `xcodebuild` output (`build/ios`), the default web build (`build/web`), and
# desktop bundles (`build/desktop`).
/build

# Cargo's own compiled-artifact cache. Deliberately NOT part of
# `build_dirs::BuildLayout`/`CLEAN_DIRS` (see that module's doc) — it is
# never removed by path, only by `cargo clean`/CARGO_TARGET_DIR override —
# but it still needs to be gitignored here: a `cargo build`/`cargo run`
# invoked with `--manifest-path` from outside this project directory, or an
# explicit `--target-dir target`, never reads this project's own
# `.cargo/config.toml` (config discovery walks up from the CURRENT
# directory, not the manifest), so it falls back to cargo's plain `target/`
# default instead of `build/rust`.
/target

# Android release signing material — never commit (see frust.toml [signing]).
android/key.properties
*.jks
*.keystore

# Written by `frust build`/`frust run --release` with the signing values the
# CLI gate resolved (plaintext passwords, owner-only) and deleted again the
# moment Gradle returns. One should only ever exist mid-build — if you see it
# in `git status`, a build was killed hard; delete it.
android/.frust-signing.properties

# legacy layout — harmless to keep: build-output paths from before the
# `build/` root migration (kept in sync with `build_dirs::LEGACY_CLEAN_DIRS`,
# which `frust clean` still removes for a pre-migration app whose generated
# Gradle/Xcode config still writes to these paths). `android/build/` is the
# `:frust-embedding` module's redirected output — see
# android/settings.gradle.kts' `gradle.lifecycle.beforeProject` block.
android/app/build/
android/build/
android/.gradle/
dist/
windows/icon.ico
android/app/src/main/jniLibs/

# Machine-local: the Android SDK path, the CLI-written version stamps, and
# the directory of every Frust Gradle module (`frust.embedding.dir`,
# `frust.plugin.<module>.dir`) that `settings.gradle.kts` reads.
android/local.properties

# Xcode's per-user state: window layout, breakpoints, scheme order. Written
# into the .xcodeproj/.xcworkspace (and beside local Swift packages under
# .swiftpm/) whenever the project is opened in Xcode; never shared config.
xcuserdata/
.swiftpm/

# Machine-local symlinks to the local Swift packages the Xcode project
# references by name — `FrustEmbedding` (the `frust-shell-ios` crate's) and
# one per plugin package (`FrustIap`, `FrustCamera`, ...) — written by `frust
# create` / the TUI's Add Plugin and refreshed by `frust run` / `frust build`;
# each target is wherever cargo resolved that crate.
/ios/Frust*
