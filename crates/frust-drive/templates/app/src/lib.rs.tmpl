use frust::{Align, Alignment, Component, CrossAxisAlignment, View, column, icon, scaffold, text};
use frust_material::{AppBarContainer, app_bar, fab, icons};

#[derive(Default)]
pub struct {{ title_case_name | replace(" ", "") }}App;

pub struct AppState {
    pub count: u32,
}

impl Component for {{ title_case_name | replace(" ", "") }}App {
    type State = AppState;

    fn init(&self) -> AppState {
        AppState { count: 0 }
    }

    fn build(&self, state: &mut AppState) -> impl View<AppState> {
        scaffold(Align(
            Alignment::CENTER,
            column()
                .child(text("You have pushed the button this many times:"))
                .child(text(state.count.to_string()).size(48.0))
                .cross_axis(CrossAxisAlignment::Center),
        ))
        .app_bar(
            app_bar("{{ title_case_name }}")
                .container(AppBarContainer::InversePrimary)
                .elevation(2),
        )
        .fab(Self::increment_fab())
    }
}

impl {{ title_case_name | replace(" ", "") }}App {
    fn increment_fab() -> impl View<AppState> {
        fab(icon(icons::ADD), |state: &mut AppState| state.count += 1).label("Increment")
    }
}

// `setup` runs once on the UI thread before the root `init`. Material 3 is the
// design system; swap in `frust_glyph::install()` or `frust_cupertino::install()`
// (and the matching `Cargo.toml` dependency) to change it.
frust::app!(
    {{ title_case_name | replace(" ", "") }}App,
    setup = {
        frust_material::install();
    }
);
