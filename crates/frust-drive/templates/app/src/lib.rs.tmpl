//! {{ title_case_name }} — generated by `frust create`.
//!
//! A ready-to-run notes app: type a note into the [`text_input`] and press
//! Enter to add it to a keyed list (each row carries a stable id, so deleting
//! one removes the *right* row), with an embedded logo [`Image`] decoded once —
//! the TextInput/IME, Image, and keyed-children stack plus the
//! layout/scroll/button vocabulary in one screen. Edit `app_logic` to make it
//! yours; never edit [`frust::app!`]'s invocation below or `main.rs` — these
//! wire the fixed entry-point shape every generated app shares.

use frust::{
    AnyView, Axis, Button, Column, Component, FlexView, Image, ImageFit, ImageSource, Row,
    SizedBox, View, any, keyed, safe_area, scroll_view, text, text_input,
};
// `frust-shared-preferences`: a platform plugin (not part of the `frust`
// facade — added to `Cargo.toml` like any other Frust plugin) this app uses
// to persist its notes list + draft across a kill+relaunch. See
// `AppState::new`/`save_notes`/`save_draft` below for the whole demo.
use frust_shared_preferences::SharedPreferences;

/// The embedded logo bytes, decoded once at startup (see [`AppState::new`]).
/// Bundling them with `include_bytes!` keeps the app self-contained — no runtime
/// asset path to resolve on Android/iOS.
const LOGO_PNG: &[u8] = include_bytes!("../assets/logo.png");

/// `frust-shared-preferences` keys this app persists under.
const NOTES_KEY: &str = "notes";
const DRAFT_KEY: &str = "draft";

/// Application state (the `app_logic` model): the view is a pure function of
/// these fields, and every interaction mutates one of them.
pub struct AppState {
    /// The in-progress note text bound to the field (a controlled component:
    /// the field reports edits through `on_change` and never self-owns its text).
    pub draft: String,
    /// Submitted notes: `(stable id, text)`. The id is the keyed identity, so a
    /// reordered/trimmed list preserves each surviving row's widget.
    pub notes: Vec<(u64, String)>,
    /// The next id to assign — monotonic, never reused, so keys stay unique.
    pub next_id: u64,
    /// The decode-once logo handle, re-passed into [`Image`] every frame (a cheap
    /// `Arc` clone — never a re-decode).
    pub logo: ImageSource,
    /// The platform preferences handle `frust-shared-preferences::standard`
    /// opened at startup, or `None` if it's unavailable this run (e.g. an
    /// old scaffold missing the Android `nativeInitPlatform` call, or a
    /// backend that hasn't landed on this target yet). Every save below
    /// degrades to a silent no-op when this is `None` — losing persistence
    /// is never a reason to panic or block the app from booting.
    ///
    /// In a browser this is always `None`: the plugin compiles for `wasm32`
    /// unchanged, but its file backend finds no user data directory there,
    /// so `SharedPreferences::standard()` returns an `Err` and the notes
    /// live for the lifetime of the tab. Swapping in a `localStorage`-backed
    /// store is app-level work, not something this scaffold assumes.
    prefs: Option<SharedPreferences>,
}

impl AppState {
    /// Build the initial state, decoding the embedded logo exactly once and
    /// loading any previously-saved notes + draft back in (the
    /// `frust-shared-preferences` demo: see the module doc).
    pub fn new() -> Self {
        let prefs = match SharedPreferences::standard() {
            Ok(prefs) => Some(prefs),
            Err(err) => {
                // Fall back to empty state rather than panicking — an old
                // scaffold or a not-yet-implemented backend just means this
                // run won't persist notes.
                //
                // `log::warn!`, not `eprintln!`: stderr is a silent no-op in
                // a browser, and the `log` facade reaches every platform's
                // real sink (the browser console through the web shell's own
                // bridge, logcat on Android, stderr on desktop). `warn` is
                // also the one level a `--release` build keeps — see
                // `Cargo.toml`'s `lean` feature.
                log::warn!("preferences unavailable, notes won't persist this run: {err}");
                None
            }
        };

        // Reassign ids on load: only the note text round-trips through
        // preferences (`set_string_list`), the ids are a local reconciliation
        // key, regenerated fresh every launch.
        let mut next_id = 0;
        let notes = prefs
            .as_ref()
            .and_then(|p| p.get_string_list(NOTES_KEY))
            .unwrap_or_default()
            .into_iter()
            .map(|text| {
                let id = next_id;
                next_id += 1;
                (id, text)
            })
            .collect();
        let draft = prefs
            .as_ref()
            .and_then(|p| p.get_string(DRAFT_KEY))
            .unwrap_or_default();

        Self {
            draft,
            notes,
            next_id,
            logo: ImageSource::decode(LOGO_PNG).expect("the embedded logo PNG is valid"),
            prefs,
        }
    }

    /// Submit the current `draft` as a new keyed note and clear the field. An
    /// empty/whitespace-only draft is dropped (still clearing the field).
    pub fn submit_draft(&mut self, text: String) {
        let trimmed = text.trim();
        if !trimmed.is_empty() {
            let id = self.next_id;
            self.next_id += 1;
            self.notes.push((id, trimmed.to_string()));
            self.save_notes();
        }
        self.draft.clear();
        self.save_draft();
    }

    /// Persist the current note texts through `frust-shared-preferences`, a
    /// no-op when no preferences handle is available (see `prefs`' doc).
    fn save_notes(&self) {
        let Some(prefs) = &self.prefs else {
            return;
        };
        let texts: Vec<String> = self.notes.iter().map(|(_, text)| text.clone()).collect();
        if let Err(err) = prefs.set_string_list(NOTES_KEY, texts) {
            log::warn!("failed to save notes: {err}");
        }
    }

    /// Persist the in-progress draft, so a kill+relaunch resumes mid-note.
    fn save_draft(&self) {
        let Some(prefs) = &self.prefs else {
            return;
        };
        if let Err(err) = prefs.set_string(DRAFT_KEY, self.draft.clone()) {
            log::warn!("failed to save draft: {err}");
        }
    }
}

impl Default for AppState {
    fn default() -> Self {
        Self::new()
    }
}

/// Pure view function: renders `AppState` into the notes screen. Re-run
/// on every state mutation, so keep it cheap by construction — the decoded logo
/// is an `Arc` clone here, never a re-decode.
///
/// `+ use<>` opts the return type out of capturing the `&mut AppState`
/// lifetime — required in edition 2024, where `-> impl Trait` otherwise
/// captures all in-scope lifetimes. The view borrows nothing from `state`
/// (views are `'static`), so capturing nothing is correct.
pub fn app_logic(state: &mut AppState) -> impl View<AppState> + use<> {
    let logo = state.logo.clone();
    let draft = state.draft.clone();

    // The submitted notes, each a keyed row: the note text plus a Delete button
    // that removes *this* id. The stable key means deleting the middle row drops
    // the middle row's widget, not whatever now sits at that index.
    let rows: Vec<frust::FlexChild<AppState>> = state
        .notes
        .iter()
        .map(|(id, note)| {
            let id = *id;
            keyed(
                id,
                Row(vec![
                    any(text(note.clone()).size(20.0)),
                    any(SizedBox(Some(12.0), None)),
                    any(Button("Delete", move |s: &mut AppState| {
                        s.notes.retain(|(nid, _)| *nid != id);
                        s.save_notes();
                    })),
                ]),
            )
        })
        .collect();

    let mut children: Vec<AnyView<AppState>> = Vec::with_capacity(4);
    // The logo sizes to its natural box and `Contain`-fits into it.
    children.push(any(Image(logo).fit(ImageFit::Contain)));
    children.push(any(text("Notes").size(32.0)));
    children.push(any(text_input(draft, |s: &mut AppState, v: String| {
        s.draft = v;
        s.save_draft();
    })
    .placeholder("Write a note, then press Enter")
    .on_submit(|s: &mut AppState, v: String| {
        s.submit_draft(v);
    })));
    children.push(any(scroll_view(FlexView::new(Axis::Vertical, rows))));

    // SafeArea pads the root view by the window's system-bar/notch/gesture-nav insets,
    // keeping content visible and interactive. Remove it to render edge-to-edge.
    safe_area(Column(children))
}

/// The generated app's root [`Component`]: stateless config
/// (`Default`-constructed) that wires [`AppState`] as its local state.
/// `init` decodes the embedded logo exactly once; `build` re-runs the pure
/// [`app_logic`] view function above on every rebuild.
#[derive(Default)]
pub struct {{ title_case_name | replace(" ", "") }}App;

impl Component for {{ title_case_name | replace(" ", "") }}App {
    type State = AppState;

    fn init(&self) -> AppState {
        AppState::new()
    }

    fn build(&self, state: &mut AppState) -> AnyView<AppState> {
        any(app_logic(state))
    }
}

// The generated app's sole entry point: one line binds
// `{{ title_case_name | replace(" ", "") }}App` to all four platforms — the
// Android JNI exports (`target_os = "android"` only), the iOS C-ABI exports
// (unconditional; self-gated to `target_os = "ios"`), the browser's
// `#[wasm_bindgen(start)]` entry (`target_arch = "wasm32"` only, through
// `frust::web_app!`), and (on desktop) the hidden `__frust_main` that
// `main.rs` calls. Never edit this line or `main.rs` — add screens/state to
// `app_logic`/`AppState` above instead. `main.rs`'s own `wasm32` arm exists
// only to keep this library — and the browser entry generated below — in
// that binary target's link graph; see its comment for why.
// The `setup` block runs once, on the UI thread, before the root
// component's `Component::init` (`frust_glyph::install`'s own doc comment
// has the full ordering contract); `frust_glyph::install()` is what makes
// Glyph this app's design system — every shell otherwise falls back to a
// design-language-free `Theme::neutral()`. Delete this call (and
// `Cargo.toml`'s `frust-glyph` dependency) for a neutral-themed app, or
// swap it for `frust_material::install()` / `frust_cupertino::install()`
// (and the matching `Cargo.toml` dependency) to use one of the other two
// built-in design systems instead.
frust::app!(
    {{ title_case_name | replace(" ", "") }}App,
    setup = {
        frust_glyph::install();
    }
);
