//! [`LoadCount`] — loads the stored count.
//!
//! Never call [`UseCase::execute`] directly from a controller — always drive
//! it through `ControllerCore::run`/`run_into` (see
//! `presentation::controllers::CounterController::load`).

use std::sync::Arc;

use clean_signals::{NoParams, UseCase};

use crate::failure::AppFailure;
use crate::features::counter::domain::repositories::CounterRepository;

/// Loads the count via the injected [`CounterRepository`].
pub struct LoadCount {
    repo: Arc<dyn CounterRepository + Send + Sync>,
}

impl LoadCount {
    /// Construct with the injected repository.
    pub fn new(repo: Arc<dyn CounterRepository + Send + Sync>) -> Self {
        Self { repo }
    }
}

#[cfg_attr(not(target_arch = "wasm32"), clean_signals::async_trait)]
#[cfg_attr(target_arch = "wasm32", clean_signals::async_trait(?Send))]
impl UseCase for LoadCount {
    type Params = NoParams;
    type Output = u32;
    type Failure = AppFailure;

    async fn execute(&self, _params: NoParams) -> Result<u32, AppFailure> {
        self.repo.load().await
    }
}
