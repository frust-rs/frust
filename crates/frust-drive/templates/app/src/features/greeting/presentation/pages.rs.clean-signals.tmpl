//! The root page — generated by `frust create --arch clean-signals`
//! (huddle clean-architecture refactor).
//!
//! [`init_controller`]/[`greeting_page`] are what `crate`'s root
//! `Component` (`{{ title_case_name | replace(" ", "") }}App`, the
//! composition root in `lib.rs`) delegates its `init`/`build` to: the
//! repository is constructed once in the composition root and handed in
//! here as a plain prop (team-demo's simple prop-passing convention — a
//! single page means no `provide_context`/`use_context` indirection is
//! needed, unlike `examples/huddle`'s multi-route case).

use std::sync::Arc;

use clean_signals::Failure;
use clean_signals_frust::{async_view, use_controller};
use frust::{AnyView, Button, Column, Get, any, spawn_local, text};

use crate::failure::AppFailure;
use crate::features::greeting::domain::repositories::GreetingRepository;
use crate::features::greeting::presentation::controllers::GreetingController;

/// Builds the page's [`GreetingController`], wired to the injected `repo`
/// prop, and kicks off the initial load. Called once from the root
/// `Component::init`, where a reactive `Owner` is ambient (`use_controller`'s
/// disposal-on-unmount `on_cleanup` binds correctly there).
pub fn init_controller(repo: Arc<dyn GreetingRepository + Send + Sync>) -> Arc<GreetingController> {
    let controller =
        use_controller::<GreetingController, AppFailure>(move || GreetingController::new(repo));
    let handle = Arc::clone(&controller);
    spawn_local(async move {
        handle.load().await;
    });
    controller
}

/// Renders the current load state: a placeholder while loading, the
/// resolved greeting plus a "Reload" button on success, or a failure
/// message — preserves the demo's original visible behavior (~400ms load,
/// Reload button, Loading/Data/Error states).
pub fn greeting_page(state: &mut Arc<GreetingController>) -> AnyView<Arc<GreetingController>> {
    // Tracked read: `GreetingController::load` writes this signal from the
    // spawned task in `init_controller` (or a later "Reload" tap), waking
    // the frame (see `docs/ARCHITECTURE.md`'s Signal-driven wake).
    let snapshot = state.greeting.get();
    async_view(
        snapshot,
        || any(text("Loading…").size(24.0)),
        |greeting: String| {
            any(Column(vec![
                any(text(greeting).size(24.0)),
                any(Button("Reload", |s: &mut Arc<GreetingController>| {
                    let handle = Arc::clone(s);
                    spawn_local(async move {
                        handle.load().await;
                    });
                })),
            ]))
        },
        |failure: AppFailure| any(text(failure.user_message()).size(20.0)),
    )
}

