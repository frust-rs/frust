//! {{ title_case_name }} — a counter app generated by `frust create --arch
//! clean-signals` (a feature-slice clean-architecture scaffold).
//!
//! It mirrors `examples/huddle`'s `src/features/<feature>/{domain,data,presentation}/`
//! convention at the smallest scale — one `counter` feature slice
//! ([`features::counter`]):
//!
//! - `domain` — the [`CounterRepository`] contract and the `LoadCount`/
//!   `IncrementCount` use cases.
//! - `data` — [`InMemoryCounterRepository`], the trait implementation over an
//!   in-memory source, owning the feature's single failure-mapping site.
//! - `presentation` — [`CounterController`] (the view model) and the page,
//!   built from small widget fns, that this file's root [`Component`]
//!   delegates to.
//!
//! This file is the **composition root**: `Component::init` builds the
//! [`CounterRepository`] implementation once and passes it straight into
//! `presentation::pages::init_controller` as a prop. See
//! `plugins/clean-signals-frust/src/lib.rs`'s "page-controller pattern" docs
//! for the contract the page functions rely on, and `examples/huddle`'s
//! `lib.rs` for the context-injection variant a multi-route app needs.
//!
//! Never edit the [`frust::app!`] line below or `main.rs`: they wire the entry
//! point every generated app shares. Add features above it instead.

pub mod failure;
pub mod features;

use std::sync::Arc;

use frust::{AnyView, Component};

use features::counter::data::repositories::InMemoryCounterRepository;
use features::counter::domain::repositories::CounterRepository;
use features::counter::presentation::{self, CounterController};

/// The root component — the composition root: builds the
/// [`CounterRepository`] implementation and delegates everything else to
/// [`presentation::pages`].
#[derive(Default)]
pub struct {{ title_case_name | replace(" ", "") }}App;

impl Component for {{ title_case_name | replace(" ", "") }}App {
    type State = Arc<CounterController>;

    fn init(&self) -> Arc<CounterController> {
        let repo: Arc<dyn CounterRepository + Send + Sync> =
            Arc::new(InMemoryCounterRepository::new());
        presentation::pages::init_controller(repo)
    }

    fn build(&self, state: &mut Arc<CounterController>) -> AnyView<Arc<CounterController>> {
        presentation::pages::counter_page(state)
    }
}

// One line binds the app to every platform: the Android JNI exports, the iOS
// C-ABI exports, the browser's wasm entry and the desktop `__frust_main`.
// `setup` runs once on the UI thread before the root `init`. Material 3 is the
// design system; swap in `frust_glyph::install()` or
// `frust_cupertino::install()` (and the matching `Cargo.toml` dependency).
frust::app!(
    {{ title_case_name | replace(" ", "") }}App,
    setup = {
        frust_material::install();
    }
);
