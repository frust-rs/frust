[package]
name = "{{ name }}"
version = "0.1.0"
edition = "2024"
publish = false

[dependencies]
# `frust` is the ONLY dependency a design-system crate should ever need —
# every token type, the widget-authoring traits, the geometry/paint
# vocabulary, and the `set_default_theme` install hook are reached through
# the facade; see `frust::authoring` for the widget-authoring seam this
# crate's one example widget (`src/lib.rs`) is built on.
#
# The facade crate is published as `frust-ui` and imported as `frust`, because
# crates.io `frust` is held by another project
# (https://github.com/lloydmeta/frunk/issues/258). The line below is the
# crates.io release, or a path dependency when generated with `--frust-path`.
#
# Frust's own built-in design systems are sibling plugin crates, not `frust`
# Cargo features — this dependency enables nothing extra. See README.md.
{{ frust_dep_line }}
