/target
/tmp
**/*.rs.bk
/.claude/
.DS_Store

# workflow/ is a separate private repo (nested checkout) — never track it here
/workflow/

# Belt-and-braces: a consuming app redirects the embedding module's build
# directory into its own tree (`gradle.lifecycle.beforeProject`), so these
# should never appear — but a missing redirect must not commit build output
# into the framework checkout.
/platform/android/frust-embedding/build/
/platform/android/frust-embedding/.gradle/

# The iOS mirror of the above. Building the embedding package in place — a
# manual macOS package-build verification gate — drops a ~138MB SwiftPM
# `.build/` (index-build output) into the framework checkout. A consuming
# app passes its own `-derivedDataPath`, so this only appears when the
# package itself is built directly, but it must never be committed.
/platform/ios/FrustEmbedding/.build/

# Same rule for a plugin's own Swift package (`plugins/<name>/platform/ios` —
# ARCHITECTURE's plugin-contribution shape). Building one in place drops the
# same SwiftPM `.build/` index-build tree (~178MB for frust-camera); a
# consuming app passes its own `-derivedDataPath`, so this only appears on a
# direct package build. Globbed rather than path-pinned so a second plugin
# Swift package is covered the day it lands — `frust-camera` is the only
# instance today.
/plugins/*/platform/ios/.build/
